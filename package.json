{
  "name": "mastra-two-layer-preflight",
  "version": "0.2.15",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "acp:probe": "tsx --env-file-if-exists=.env scripts/acp-probe.ts",
    "start:all": "tsx --env-file-if-exists=.env src/server.ts",
    "start:l1": "L2_A2A_URL=${L2_A2A_URL:-http://127.0.0.1:4121} tsx --env-file-if-exists=.env src/server.ts",
    "start:l2-pull": "tsx --env-file-if-exists=.env src/l2-pull-worker.ts",
    "start:l2": "tsx --env-file-if-exists=.env src/l2-server.ts",
    "cf:deploy": "npm run cf:build && wrangler deploy -c .mastra/output/wrangler.json",
    "cf:build": "npm run web:build && NODE_OPTIONS=--import=$PWD/scripts/cf-workers-stub.mjs mastra build && node scripts/cf-postbuild.mjs",
    "cf:dev": "npm run cf:build && node scripts/cf-dev-vars.mjs && wrangler dev -c .mastra/output/wrangler.json --local --var PROBE_ROUTES:1",
    "web:dev": "npm run dev --prefix apps/web",
    "web:build": "npm run build --prefix apps/web"
  },
  "dependencies": {
    "@ai-sdk/provider-v5": "npm:@ai-sdk/provider@2.0.3",
    "@hono/node-server": "2.1.5",
    "@mastra/acp": "^0.4.4",
    "@mastra/cloudflare-d1": "^1.5.0",
    "@mastra/core": "^1.81.0",
    "@mastra/deployer-cloudflare": "^1.2.40",
    "@mastra/libsql": "^1.28.0",
    "@mastra/mcp": "^2.8.0",
    "@mastra/memory": "^1.40.0",
    "@mastra/server": "^1.81.0",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.16",
    "undici": "^7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "mastra": "^1.37.0",
    "tsx": "4.23.15",
    "wrangler": "^4.156.0"
  },
  "license": "MIT"
}
