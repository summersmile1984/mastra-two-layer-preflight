{
  "name": "@mastra-preflight/l2-desktop",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Mastra Desktop: chat UI (L1 /) + L2 claim runtime (ACP/CUA) in one Tauri 2 install",
  "scripts": {
    "ui:dev": "vite",
    "ui:build": "tsc -p tsconfig.ui.json --noEmit && vite build",
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.ui.json --noEmit",
    "claim:dev": "tsx --env-file-if-exists=.env src/main.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:runtime": "tsc -p tsconfig.runtime.json --noEmit || true"
  },
  "dependencies": {
    "@mastra-preflight/shared": "file:../../packages/shared",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.3.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.3.5"
  }
}
