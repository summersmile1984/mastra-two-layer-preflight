{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@mastra-preflight/shared": ["../../packages/shared/src/index.ts"]
    },
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts", "../../packages/shared/src/index.ts"]
}
