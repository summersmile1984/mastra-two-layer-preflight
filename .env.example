# 复制为 .env（已在 .gitignore），不要提交真实值
DEEPSEEK_API_KEY=sk-xxxxxxxx           # L1 模型 + dsh harness 共用
PORT=4120
# L2_MODE=queue                        # 默认 a2a；queue=同进程队列+sendSignal
# A2A_PUSH_TOKEN=                      # 不设则每次启动随机生成（不打印）
# PUBLIC_BASE_URL=https://l1.example.com   # L2 在远端时 L1 的公网回调根（如 CF Tunnel）；https 公网自动换官方 DefaultPushNotificationSender
# L2_A2A_URL=https://l2.example.com/api/a2a/l2-worker  # 远端 L2；默认同进程
# ACP_COMMAND=dsh  ACP_ARGS="--profile acp"  ACP_LOCAL_*/ACP_CLOUD_* 覆盖
# ACP_TIMEOUT_MS=900000
# ACP_DRY_RUN=1                        # 仅最后手段
# CHROME_BIN=/usr/bin/google-chrome    # 宿主截图兜底
# USE_SCRIPTED=1                       # L1 用离线脚本模型
# DEV_ENDPOINTS=1                      # 打开 /api/a2a-log、/api/demo/push-image

# ---- L1/L2 拆分 ----
# A2A_PUSH_TOKEN=                      # 推荐: openssl rand -hex 32；不设则生成到 data/push-token（已 gitignore）
# L2_PORT=4121
# L2_PUSH_ALLOWLIST=http://127.0.0.1:4120/api/a2a-callback   # L2 侧：精确回调白名单；不设=官方 sender（仅公网 https）
# L2_PUBLIC_URL=https://l2.example.com # L2 agent-card 中的 executionUrl
# L1_EMBED_L2=1                        # 设了 L2_A2A_URL 仍挂载内置 L2 路由
